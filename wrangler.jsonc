{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canadial",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "canadial" }],
  "observability": { "enabled": true },
  // The deployment's version id, part of the edge-cache key in worker.ts so a
  // new deploy never serves HTML cached by an older one.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Only the custom domains serve the site: no *.workers.dev or preview URLs,
  // which would be unprotected duplicates of it.
  "workers_dev": false,
  "preview_urls": false,
  // www and apex are Worker routes over the zone's existing (proxied) DNS
  // records, not custom domains: Cloudflare won't attach a custom domain to a
  // hostname that already has records, and deleting them first would leave a
  // window of NXDOMAIN that resolvers cache. canadial.com 308s to www in
  // worker.ts. next.canadial.com is the separate staging Worker (env.staging).
  "routes": [
    { "pattern": "www.canadial.com/*", "zone_name": "canadial.com" },
    { "pattern": "canadial.com/*", "zone_name": "canadial.com" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "canadial", "database_id": "5a39996f-3b4e-4ec8-a77e-ff67e754c2e4", "migrations_dir": "migrations" },
    // OpenNext tag cache for revalidatePath(); kept apart from app data.
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "canadial-tags", "database_id": "293d8ecd-c499-4061-b4cf-deb63a541b03" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "canadial-opennext-cache" },
    // Raw FTC files (ftc/raw/...) and data exports. Private; never served.
    { "binding": "FTC_DATA", "bucket_name": "canadial-data" }
  ],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "env": {
    // Staging: next.canadial.com, noindex (worker.ts). Same app database and
    // data bucket as production (it previews new code against real data),
    // its own ISR cache and tag cache so the two never invalidate each other.
    "staging": {
      "name": "canadial-staging",
      "routes": [{ "pattern": "next.canadial.com", "custom_domain": true }],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "canadial-staging" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "canadial", "database_id": "5a39996f-3b4e-4ec8-a77e-ff67e754c2e4", "migrations_dir": "migrations" },
        { "binding": "NEXT_TAG_CACHE_D1", "database_name": "canadial-staging-tags", "database_id": "49d75b31-d884-49d5-808d-5761d855592c" }
      ],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "canadial-staging-cache" },
        { "binding": "FTC_DATA", "bucket_name": "canadial-data" }
      ],
      "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "version_metadata": { "binding": "CF_VERSION_METADATA" }
    },
    // Used only by `next build` (see next.config.ts): pages prerendered at build
    // time read the production database, as Vercel builds read Supabase. Local
    // `next dev` uses the default (local) bindings and never touches production.
    "build": {
      "routes": [],
      "d1_databases": [
        { "binding": "DB", "database_name": "canadial", "database_id": "5a39996f-3b4e-4ec8-a77e-ff67e754c2e4", "remote": true }
      ]
    }
  }
}
